{
  "name": "conduit-qa-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test automation platform for a self-hosted RealWorld Conduit app",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:smoke": "bddgen && playwright test --grep @smoke --project=ui-chromium --project=api",
    "test:regression": "bddgen && playwright test --project=ui-chromium --project=hybrid-chromium --project=api",
    "test:firefox": "bddgen && playwright test --project=ui-firefox --project=hybrid-firefox",
    "test:api": "playwright test --project=api",
    "test:hybrid": "playwright test --project=hybrid-chromium",
    "seed": "node src/scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "playwright-bdd": "9.2.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "zod": "4.6.5"
  }
}
